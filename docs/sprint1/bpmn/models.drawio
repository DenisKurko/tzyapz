        <mxCell id="lane2" value="Одержувач платежу" style="swimlane;horizontal=0;startSize=42;collapsible=0;fillColor=#f7f9fc;strokeColor=#667085;fontStyle=1;fontSize=14;whiteSpace=wrap;" parent="1" vertex="1">
