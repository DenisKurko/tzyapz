        <mxCell id="n13" value="«Операціоніст підтвердив?» - «ні» → 19; «так» → 14" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
