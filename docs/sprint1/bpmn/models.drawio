        <mxCell id="n12" value="«Підтвердити операцію понад ліміт»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
