        <mxCell id="lane3" value="—" style="swimlane;horizontal=0;startSize=42;collapsible=0;fillColor=#f7f9fc;strokeColor=#667085;fontStyle=1;fontSize=14;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1290" y="90" width="390" height="1695" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="«Надійшов рахунок до оплати»" style="ellipse;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="«Ввести одержувача (назва, адреса, телефон, рахунок) і суму»; асоціація до об&#39;єкта даних «Платіжне доручення»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="65" y="300" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="«Надіслати рахунок на оплату» - потік повідомлень до 7" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="65" y="445" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="«Отримано підтвердження оплати» → 5; «Отримано повідомлення про помилку» → 6" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="65" y="590" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="«Рахунок оплачено»" style="ellipse;fillColor=#fdecec;strokeColor=#b42318;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="735" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="«Оплату не виконано»" style="ellipse;fillColor=#fdecec;strokeColor=#b42318;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="880" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="«Отримано платіжне доручення»" style="ellipse;fillColor=#ffffff;strokeColor=#2878b5;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="485" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="«Перевірити повноту і формат полів»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="300" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="«Поля коректні?» - «ні» → 10; «так» → 11" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="445" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="«Повідомити помилку у реквізитах» → до 4; далі кінцева подія «Помилка у реквізитах»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="590" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="«Перевірити баланс рахунку»; асоціація до сховища «Реєстр рахунків»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
