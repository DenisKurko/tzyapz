        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml M3_Кредит\ntitle M3 — Оформлення кредиту\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor #eef3fb\n  BorderColor #31558a\n  DiamondBackgroundColor #fff8e1\n  DiamondBorderColor #a06a00\n  StartColor #eafbea\n  EndColor #fdecea\n}\n\n|Клієнт|\nstart\n:Потрібен кредит;\n:Вказати суму, перший внесок\\nі рахунок;\n:Подати заявку;\n\n|ФінКит — система (скоринг)|\n:Отримано заявку на кредит;\n:Перевірити межі суми і строку;\nif (Параметри в межах?) then (так)\n  :Скоринг заявки;\n  note right\n  Перевірка доходу,\n  кредитної історії\n  та наявного ліміту.\n  end note\n  if (Результат скорингу?) then (схвалено)\n    :Повідомити схвалення й умови;\n    |Клієнт|\n    :Підтвердити умови кредиту;\n    if (Умови підтверджено?) then (так)\n      |ФінКит — система|\n      :Зарахувати кошти,\\nстворити графік платежів;\n      :Кредит видано;\n    else (ні)\n      :Умови не підтверджено;\n    endif\n  elseif (грани-відмова)\n    :Повідомити автоматичну відмову;\n    :Відмовлено автоматично;\n  else (підтвердження потрібне)\n    :Передати заявку ризик-менеджеру;\n    |Ризик-менеджер|\n    :Розглянути заявку вручну;\n    if (Рішення ризик-менеджера?) then (схвалено)\n      |ФінКит — система|\n      :Повідомити схвалення й умови;\n      |Клієнт|\n      :Підтвердити умови кредиту;\n      |ФінКит — система|\n      :Зарахувати кошти,\\nстворити графік платежів;\n      :Кредит видано;\n    else (відхилено)\n      |ФінКит — система|\n      :Повідомити відмову;\n      :Відмовлено ризик-менеджером;\n    endif\n  endif\nelse (ні)\n  :Повідомити відмову через межі параметрів;\n  :Кредит не надано;\nendif\nstop\n\nnote left\nОнлайн-калькулятор і подання\nз калькулятора — замовлення\nна нову функцію (О-1…О-6);\nу поточній версії відсутні.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XjAoHK73WAda3_O11and-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
