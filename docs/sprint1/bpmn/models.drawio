          <mxGeometry x="30" y="25" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lane0" value="Клієнт" style="swimlane;horizontal=0;startSize=42;collapsible=0;fillColor=#f7f9fc;strokeColor=#667085;fontStyle=1;fontSize=14;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="30" y="90" width="390" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="lane1" value="ФінКит&#xa;Система" style="swimlane;horizontal=0;startSize=42;collapsible=0;fillColor=#f7f9fc;strokeColor=#667085;fontStyle=1;fontSize=14;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="450" y="90" width="390" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="ФінКит&#xa;Ризик-менеджер" style="swimlane;horizontal=0;startSize=42;collapsible=0;fillColor=#f7f9fc;strokeColor=#667085;fontStyle=1;fontSize=14;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="870" y="90" width="390" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="—" style="swimlane;horizontal=0;startSize=42;collapsible=0;fillColor=#f7f9fc;strokeColor=#667085;fontStyle=1;fontSize=14;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1290" y="90" width="390" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="«Потрібен кредит»" style="ellipse;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="«Вказати суму, перший внесок і рахунок»; асоціація до об&#39;єкта даних «Заявка на кредит»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="65" y="300" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="«Подати заявку» - потік повідомлень до 10" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="65" y="445" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="«Отримано рішення за заявкою»" style="ellipse;fillColor=#fffaf0;strokeColor=#a06a00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="590" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="«Рішення позитивне?» - «ні» → 6; «так» → 7" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="65" y="735" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="«Кредит не надано»" style="ellipse;fillColor=#fdecec;strokeColor=#b42318;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="880" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="«Підтвердити умови кредиту»; на межі - «Минуло 7 днів» → 8" style="ellipse;fillColor=#fffaf0;strokeColor=#a06a00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="1025" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="«Умови не підтверджено»" style="ellipse;fillColor=#fdecec;strokeColor=#b42318;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="1170" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="«Кредит отримано»" style="ellipse;fillColor=#fdecec;strokeColor=#b42318;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="65" y="1315" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="«Отримано заявку на кредит»" style="ellipse;fillColor=#ffffff;strokeColor=#2878b5;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="485" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="«Перевірити межі суми і строку»; асоціація до анотації 20" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="300" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="«Параметри в межах?» - «ні» → 17; «так» → 13" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="445" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="«Скоринг заявки» — внутрішні кроки: перевірка доходу, кредитної історії, наявного ліміту" style="rounded=1;arcSize=12;fillColor=#e4f4ea;strokeColor=#287a45;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="590" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="«Результат скорингу?» - «відмова» → 17; «гранична оцінка або велика сума» → 15; «схвалено» → 18" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="735" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="«Повідомити автоматичну відмову» → до 4; далі кінцева подія «Відмовлено автоматично»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="880" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="«Повідомити схвалення й умови» → до 4" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="1025" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="«Отримано підтвердження умов» → 21; «Минуло 7 днів» (таймер) → кінцева подія «Не підтверджено»" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="1170" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="«Зарахувати кошти і створити графік платежів»; асоціація до об&#39;єкта даних «Графік платежів»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="1315" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="«Кредит видано»" style="ellipse;fillColor=#fdecec;strokeColor=#b42318;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="485" y="1460" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="«Розглянути заявку вручну»; асоціація до об&#39;єкта даних «Заявка на кредит»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="905" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="«Рішення ризик-менеджера?» - «відхилено» → кінцева подія «Відмовлено ризик-менеджером»; «схвалено» → 18" style="rhombus;fillColor=#fff4d6;strokeColor=#a06a00;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="905" y="300" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="«Сума 1 000..1 000 000 грн, строк 3..60 місяців, ставка 5..40 % (BL-30)» (до 11)" style="shape=note;fillColor=#fffbd6;strokeColor=#8a6d1d;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1325" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="«Онлайн-калькулятор, подання заявки з калькулятора і статус у кабінеті - замовлення на нову функцію (О-1…О-6); у поточній версії продукту відсутні» (до 2)" style="shape=note;fillColor=#fffbd6;strokeColor=#8a6d1d;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
