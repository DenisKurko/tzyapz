          <mxGeometry x="485" y="1605" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="«Записати обидві операції в історію і повідомити клієнта» → до 4; асоціація до сховища «Журнал транзакцій»; далі кінцева подія «Переказ виконано»" style="rounded=1;arcSize=12;fillColor=#eaf2ff;strokeColor=#31558a;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="485" y="1750" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="«Скасувати списання» - прив&#39;язана до події-помилки на межі 15; далі кінцева подія «Технічна помилка»" style="rounded=1;arcSize=12;fillColor=#f5e8ff;strokeColor=#7a3e9d;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
